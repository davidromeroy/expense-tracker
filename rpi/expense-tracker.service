# systemd unit — arranca el dashboard solo al bootear la Pi y lo reinicia si crashea.
#
# Instalación (ver README Fase 3). OJO antes de copiar:
#   1. El usuario de esta Pi es `rpi` (no `pi`). Si en tu Pi es otro, cambia
#      User= y las dos rutas /home/rpi/.
#   2. Verifica dónde está node:  command -v node
#      Si NO es /usr/bin/node (típico con nvm), corrige ExecStart. systemd no
#      lee tu ~/.bashrc ni el PATH de nvm: la ruta tiene que ser absoluta.
#
#   sudo cp expense-tracker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now expense-tracker
#   systemctl status expense-tracker
#   journalctl -u expense-tracker -f

[Unit]
Description=Expense Tracker Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpi
WorkingDirectory=/home/rpi/expense-tracker/rpi
ExecStart=/usr/bin/node server.js
# always, no on-failure: si el proceso sale con código 0 (p.ej. un exit limpio
# tras un error de arranque) igual queremos que vuelva.
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# La Zero 2W tiene 512MB. Si el proceso se dispara, que lo mate el cgroup y
# systemd lo reinicie, en vez de que el OOM killer del kernel se lleve por
# delante algo más (sshd, por ejemplo) y te deje fuera de la Pi.
MemoryMax=300M

# Hardening barato (no cuesta RAM):
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
