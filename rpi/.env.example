# Copia este archivo a .env y rellena tus valores. Nunca subas .env a git.

# ID del Google Sheet (lo sacas de la URL: .../spreadsheets/d/ESTE_ID/edit)
SHEET_ID=

# Nombre de la hoja dentro del Sheet
SHEET_NAME=Movimientos

# Ruta al JSON de la cuenta de servicio de Google (ver README, Fase 2)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# API key de Google AI Studio (aistudio.google.com/api-keys, tier gratis)
# para el endpoint de preguntas en lenguaje natural (chatbot.js, Gemini)
GEMINI_API_KEY=

# Opcional — default gemini-3.5-flash-lite (500 req/día gratis, contra 20
# de los modelos "flash" normales — confirmado en aistudio.google.com/rate-limit)
GEMINI_MODEL=

# Puerto del dashboard
PORT=3000

# Cada cuántos minutos sincroniza contra el Sheet
SYNC_INTERVAL_MIN=15
