# Copia este archivo a .env y rellena tus valores. Nunca subas .env a git.

# ID del Google Sheet (lo sacas de la URL: .../spreadsheets/d/ESTE_ID/edit)
SHEET_ID=

# Nombre de la hoja dentro del Sheet
SHEET_NAME=Movimientos

# Ruta al JSON de la cuenta de servicio de Google (ver README, Fase 2)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# API key de Google AI Studio (aistudio.google.com/api-keys, tier gratis)
# para el endpoint de preguntas en lenguaje natural (chatbot.js, Gemini)
GEMINI_API_KEY=

# Opcional — default gemini-3.5-flash-lite (500 req/día gratis, contra 20
# de los modelos "flash" normales — confirmado en aistudio.google.com/rate-limit)
GEMINI_MODEL=

# Puerto del dashboard
PORT=3000

# Cada cuántos minutos sincroniza contra el Sheet
SYNC_INTERVAL_MIN=15

# Secreto propio de POST /api/alexa (solo alcanzable dentro del tailnet,
# para probar con curl a mano) — NO reusar SHARED_SECRET de Code.gs ni
# ningún otro.
ALEXA_SHARED_SECRET=

# ID de la skill de Alexa "finanzas" (formato amzn1.ask.skill.xxxxxxxx-...),
# lo da el Developer Console arriba de todo, en la página de la skill. Lo
# usa POST / (la ruta que sí queda pública vía Tailscale Funnel) para
# confirmar que el request es realmente para ESTA skill, además de
# verificar la firma criptográfica de Alexa.
ALEXA_SKILL_ID=

# Aviso de caídas (healthchecks.io). URL de ping del check, formato
# https://hc-ping.com/<uuid>. Cada HC_INTERVAL_MIN el server manda un latido;
# si deja de llegar (Pi apagada, sin red, server en bucle) o llega a /fail
# (sync parado, disco lleno), healthchecks.io avisa al celular. Vacío = sin aviso.
# Tratar la URL como secreto: con ella cualquiera puede marcar el check como sano.
HC_PING_URL=
# Opcionales — defaults: 5 min, SYNC_INTERVAL_MIN*3+5 min, 90 %
HC_INTERVAL_MIN=
SYNC_STALE_MIN=
DISCO_MAX_PCT=

# Aviso semanal por ntfy (domingo 20:00, hora de Ecuador). El push es genérico,
# sin montos: ntfy.sh es público y sin cifrar. Usá un tema NUEVO, largo y al
# azar, distinto del de las alertas de caída, y no lo compartas. Vacío = sin aviso.
RESUMEN_NTFY_TOPIC=
# Dirección que abre al tocar el aviso (dashboard por Tailscale, sin secretos).
# Ej.: http://<IP-tailscale-de-la-Pi>:3000/dashboard.html#semana
RESUMEN_URL=
# Opcionales — defaults: https://ntfy.sh y '0 20 * * 0'
NTFY_SERVER=
RESUMEN_CRON=
